{
  "$schema": "https://x402.org/schemas/v2/bazaar-discovery.json",
  "version": "0.2.0",
  "provider": {
    "name": "x402 Agent Microservice",
    "description": "Production x402-compliant API micro-service accepting USDC payments on Base Mainnet",
    "website": "https://x402-agent-service.vercel.app",
    "manifestUrl": "https://x402-agent-service.vercel.app/.well-known/x402",
    "repository": "https://github.com/rishiicreates/x402-agent-service"
  },
  "settlement": {
    "network": "base",
    "chainId": 8453,
    "asset": "USDC",
    "tokenAddress": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
    "decimals": 6,
    "payeeAddress": "0x3028C30B8c8985Bd54669BC313Fe7950fCeB1142",
    "rpcUrl": "https://mainnet.base.org"
  },
  "resources": [
    {
      "id": "crossword-generator",
      "name": "Dynamic Crossword Generator",
      "description": "Generates dynamic crossword grid layout with rebus & progressive clues",
      "path": "/api/crossword/generate",
      "method": "POST",
      "priceUsdc": 0.50,
      "amountUnits": "500000",
      "headers": {
        "Content-Type": "application/json",
        "X-PAYMENT": "<base_usdc_transaction_hash>"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "description": "Crossword theme topic or genre",
            "default": "Decentralized Systems & AI"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "default": "medium"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "puzzle": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "dimensions": { "type": "object" },
              "grid": { "type": "array" },
              "clues": { "type": "array" },
              "features": { "type": "object" }
            }
          },
          "payment": { "type": "object" }
        }
      }
    },
    {
      "id": "email-validator",
      "name": "Fast Email & MAP Validator",
      "description": "Fast MAP protocol & RFC 5322 email schema validator with live DNS MX lookup",
      "path": "/api/verify/email",
      "method": "POST",
      "priceUsdc": 0.25,
      "amountUnits": "250000",
      "headers": {
        "Content-Type": "application/json",
        "X-PAYMENT": "<base_usdc_transaction_hash>"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address to validate"
          },
          "checkMx": {
            "type": "boolean",
            "default": true,
            "description": "Whether to query live DNS MX host records"
          }
        },
        "required": ["email"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "validation": {
            "type": "object",
            "properties": {
              "email": { "type": "string" },
              "validSyntax": { "type": "boolean" },
              "deliverable": { "type": "boolean" },
              "score": { "type": "number" },
              "risk": { "type": "string" },
              "checks": { "type": "object" }
            }
          },
          "payment": { "type": "object" }
        }
      }
    }
  ]
}
